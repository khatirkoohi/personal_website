---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title="Contact" description={`How to reach ${site.name}.`}>
  <p class="eyebrow">Contact</p>
  <h1>Get in touch</h1>
  <p class="lede">Email is the best way to reach me. I reply within two working days.</p>
  <dl class="list">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    </div>
    {
      site.github && (
        <div>
          <dt>GitHub</dt>
          <dd><a href={site.github}>{site.github.replace("https://", "")}</a></dd>
        </div>
      )
    }
    {
      site.linkedin && (
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={site.linkedin}>{site.linkedin.replace("https://", "")}</a></dd>
        </div>
      )
    }
  </dl>
</Base>

<style>
  .list {
    max-width: var(--measure);
    margin: 2rem 0 0;
  }
  .list div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .list div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
